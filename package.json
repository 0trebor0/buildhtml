{
  "name": "@trebor/buildhtml",
  "version": "1.2.4",
  "description": "Server-side HTML compiler for Node.js. Build pages with a JavaScript API while reactive state, events, and DOM bindings compile automatically.",
  "main": "index.js",
  "types": "typescript/index.d.ts",
  "files": [
    "index.js",
    "benchmark/",
    "docs/",
    "example/account-form.js",
    "example/dashboard.js",
    "example/routing.js",
    "example/production-patterns.js",
    "example/auth-interface.js",
    "lib/",
    "typescript/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node example/dashboard.js",
    "test": "node test/run-all.js",
    "test:browser": "node test/test-browser.js && node test/test-dashboard-browser.js && node test/test-routing-browser.js && node test/test-auth-interface-browser.js",
    "test:types": "tsc --project typescript/tsconfig.json --noEmit",
    "benchmark": "node benchmark/render.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0trebor0/buildhtml.git"
  },
  "keywords": [
    "html",
    "html-builder",
    "ssr",
    "server-side-rendering",
    "nodejs",
    "reactive",
    "template",
    "no-dependencies",
    "dashboard",
    "report"
  ],
  "author": "0trebor0 <webdevme@outlook.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "bugs": {
    "url": "https://github.com/0trebor0/buildhtml/issues"
  },
  "homepage": "https://github.com/0trebor0/buildhtml#readme"
}
