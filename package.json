{
  "name": "@trebor/buildhtml",
  "version": "1.2.5",
  "description": "Server-side HTML compiler for Node.js. Build pages with a JavaScript API while reactive state, events, and DOM bindings compile automatically.",
  "type": "commonjs",
  "main": "index.js",
  "module": "index.mjs",
  "types": "typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./typescript/index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./template": {
      "types": "./typescript/template.d.ts",
      "default": "./lib/template.js"
    },
    "./middleware": {
      "types": "./typescript/middleware.d.ts",
      "default": "./lib/middleware.js"
    },
    "./components": {
      "types": "./typescript/components.d.ts",
      "default": "./lib/components.js"
    },
    "./live": {
      "types": "./typescript/live.d.ts",
      "default": "./lib/live.js"
    },
    "./config": {
      "types": "./typescript/config.d.ts",
      "default": "./lib/config.js"
    },
    "./metrics": {
      "types": "./typescript/metrics.d.ts",
      "default": "./lib/metrics.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "benchmark/",
    "docs/",
    "example/account-form.js",
    "example/dashboard.js",
    "example/routing.js",
    "example/production-patterns.js",
    "example/auth-interface.js",
    "lib/",
    "typescript/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node example/dashboard.js",
    "test": "node test/run-all.js",
    "test:browser": "node test/test-browser.js && node test/test-dashboard-browser.js && node test/test-routing-browser.js && node test/test-auth-interface-browser.js",
    "test:types": "tsc --project typescript/tsconfig.json --noEmit",
    "benchmark": "node benchmark/render.js",
    "benchmark:size": "node benchmark/runtime-size.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0trebor0/buildhtml.git"
  },
  "keywords": [
    "html",
    "html-builder",
    "ssr",
    "server-side-rendering",
    "nodejs",
    "reactive",
    "template",
    "no-dependencies",
    "dashboard",
    "report"
  ],
  "author": "0trebor0 <webdevme@outlook.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=17.0.0"
  },
  "bugs": {
    "url": "https://github.com/0trebor0/buildhtml/issues"
  },
  "homepage": "https://github.com/0trebor0/buildhtml#readme"
}
